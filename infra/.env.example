# Shopify - UK. Dev Dashboard app client credentials (not a static Admin API
# token) -- trading/build.py exchanges these for a 24h access token each run
# via the OAuth client credentials grant. See CLAUDE.md.
SHOPIFY_UK_STORE_DOMAIN=your-uk-store.myshopify.com
SHOPIFY_UK_CLIENT_ID=your-uk-app-client-id
SHOPIFY_UK_CLIENT_SECRET=your-uk-app-client-secret

# Shopify - US
SHOPIFY_US_STORE_DOMAIN=your-us-store.myshopify.com
SHOPIFY_US_CLIENT_ID=your-us-app-client-id
SHOPIFY_US_CLIENT_SECRET=your-us-app-client-secret
